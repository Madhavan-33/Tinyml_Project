# Application Settings
ENVIRONMENT=production
PORT=8501
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_SERVER_ADDRESS=0.0.0.0

# Project Paths
DATASET_DEFAULT_PATH=data/sensor_mesh_data.csv
MODEL_EXPORT_PATH=models/anomaly_model.tflite
ZIP_EXPORT_PATH=exports/mcu_package.zip

# Model Parameters (Default 9-Sensor Mesh Setup)
NUM_SENSORS=9
DEFAULT_BATCH_SIZE=32
DEFAULT_EPOCHS=50

# Optional: Set TensorFlow logging level (0 = all, 1 = no INFO, 2 = no WARNING, 3 = no ERROR)
TF_CPP_MIN_LOG_LEVEL=2