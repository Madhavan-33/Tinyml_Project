streamlit_updated_train.py
train_headless.py
dataset_generator.py
renode_serial_emulator.py
export_weights_for_vercel.py
mcu_exporter.py

# Data files
*.csv

# Cache & environments
__pycache__/
.env
.streamlit/
.git/
